
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Login | HostelCare</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">

    <style>
        /* LOGIN PAGE */

        .login-page {
            min-height: 85vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 35px 15px;
            background: #f8fafc;
        }

        .login-card {
            width: 100%;
            max-width: 440px;
            background: white;
            border: 1px solid #e2e8f0;
            border-radius: 20px;
            padding: 38px;
            box-shadow: 0 12px 35px rgba(15, 23, 42, 0.08);
        }

        .login-icon {
            width: 68px;
            height: 68px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #eff6ff;
            border-radius: 18px;
            font-size: 32px;
            margin-bottom: 22px;
        }

        .login-card h2 {
            color: #172554;
            font-weight: 800;
            margin-bottom: 8px;
        }

        .login-card .login-subtitle {
            color: #64748b;
            margin-bottom: 28px;
        }

        .login-card .form-label {
            color: #334155;
            font-weight: 650;
            font-size: 14px;
            margin-bottom: 8px;
        }

        .login-card .form-control {
            padding: 13px 14px;
            border: 1px solid #cbd5e1;
            border-radius: 10px;
            font-size: 14px;
        }

        .login-card .form-control:focus {
            border-color: #3b82f6;
            box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.12);
        }

        .password-wrapper {
            position: relative;
        }

        .password-wrapper input {
            padding-right: 75px;
        }

        .password-toggle {
            position: absolute;
            right: 12px;
            top: 50%;
            transform: translateY(-50%);
            border: none;
            background: transparent;
            color: #2563eb;
            font-size: 12px;
            font-weight: 700;
            cursor: pointer;
        }

        .login-btn {
            padding: 13px;
            border-radius: 10px;
            font-weight: 700;
            margin-top: 10px;
        }

        .login-divider {
            display: flex;
            align-items: center;
            gap: 12px;
            color: #94a3b8;
            font-size: 12px;
            margin: 25px 0;
        }

        .login-divider::before,
        .login-divider::after {
            content: "";
            flex: 1;
            height: 1px;
            background: #e2e8f0;
        }

        .login-register {
            text-align: center;
            color: #64748b;
            font-size: 14px;
        }

        .login-register a {
            color: #2563eb;
            font-weight: 700;
            text-decoration: none;
        }

        .login-register a:hover {
            text-decoration: underline;
        }

        .login-footer {
            text-align: center;
            font-size: 12px;
            color: #94a3b8;
            margin-top: 25px;
        }

        @media (max-width: 576px) {
            .login-card {
                padding: 28px 22px;
            }
        }
    </style>

</head>

<body>

    <%- include("../includes/navbar.ejs") %>


    <div class="login-page">

        <div class="login-card">


            <!-- LOGIN HEADER -->

            <div class="login-icon">
                🏠
            </div>

            <h2>Welcome Back!</h2>

            <p class="login-subtitle">
                Login to your HostelCare account and manage your hostel services.
            </p>


            <!-- ERROR MESSAGE -->

            <% if (error) { %>

                <div class="alert alert-danger rounded-3">
                    <strong>Login Failed</strong>

                    <p class="mb-0 mt-1 small">
                        <%= error %>
                    </p>
                </div>

            <% } %>


            <!-- LOGIN FORM -->

            <form action="/login" method="POST">


                <!-- EMAIL -->

                <div class="mb-3">

                    <label class="form-label">
                        Email Address
                    </label>

                    <input
                        type="email"
                        name="email"
                        class="form-control"
                        placeholder="Enter your email"
                        autocomplete="email"
                        required
                    >

                </div>


                <!-- PASSWORD -->

                <div class="mb-3">

                    <label class="form-label">
                        Password
                    </label>

                    <div class="password-wrapper">

                        <input
                            type="password"
                            name="password"
                            id="loginPassword"
                            class="form-control"
                            placeholder="Enter your password"
                            autocomplete="current-password"
                            required
                        >

                        <button
                            type="button"
                            class="password-toggle"
                            id="togglePassword">

                            Show

                        </button>

                    </div>

                </div>


                <!-- LOGIN BUTTON -->

                <button type="submit" class="btn btn-primary login-btn w-100">

                    Login to Account →

                </button>

            </form>


            <!-- REGISTER LINK -->

            <div class="login-divider">
                NEW TO HOSTELCARE?
            </div>

            <div class="login-register">

                Don't have an account?

                <a href="/register">
                    Create an account
                </a>

            </div>


            <!-- FOOTER -->

            <div class="login-footer">
                HostelCare · Hostel Maintenance Management System
            </div>

        </div>

    </div>


    <!-- PASSWORD VISIBILITY -->

    <script>
        const passwordInput = document.getElementById("loginPassword")
        const togglePassword = document.getElementById("togglePassword")

        togglePassword.addEventListener("click", () => {

            if (passwordInput.type === "password") {
                passwordInput.type = "text"
                togglePassword.textContent = "Hide"
            } else {
                passwordInput.type = "password"
                togglePassword.textContent = "Show"
            }

        })
    </script>

</body>
</html>
