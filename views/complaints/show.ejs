
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Complaint Details | HostelCare</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">

    <style>
        /* COMPLAINT DETAILS PAGE */

        .details-header {
            background: linear-gradient(120deg, #172554, #2563eb);
            color: white;
            padding: 30px;
            border-radius: 18px;
            margin-bottom: 25px;
        }

        .details-header h2 {
            color: white;
            font-weight: 750;
        }

        .details-header p {
            color: #dbeafe;
        }

        .details-card {
            background: white;
            border: 1px solid #e2e8f0;
            border-radius: 16px;
            box-shadow: 0 5px 20px rgba(15, 23, 42, 0.05);
            margin-bottom: 22px;
            overflow: hidden;
        }

        .details-card-header {
            padding: 20px 24px;
            border-bottom: 1px solid #e2e8f0;
        }

        .details-card-header h5 {
            color: #172554;
            font-weight: 750;
            margin: 0;
        }

        .details-card-body {
            padding: 25px;
        }

        .detail-item {
            background: #f8fafc;
            border: 1px solid #e2e8f0;
            border-radius: 12px;
            padding: 16px;
            height: 100%;
        }

        .detail-label {
            color: #64748b;
            font-size: 12px;
            font-weight: 650;
            text-transform: uppercase;
            margin-bottom: 7px;
        }

        .detail-value {
            color: #172554;
            font-weight: 700;
            margin: 0;
            overflow-wrap: anywhere;
        }

        .complaint-description {
            background: #f8fafc;
            border: 1px solid #e2e8f0;
            padding: 20px;
            border-radius: 12px;
            color: #475569;
            line-height: 1.8;
            white-space: pre-wrap;
            overflow-wrap: anywhere;
        }

        .status-badge {
            font-size: 13px;
            padding: 9px 15px;
            border-radius: 30px;
            font-weight: 650;
        }

        /* PROGRESS TRACKER */

        .progress-track {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            position: relative;
            margin: 30px 10px 15px;
        }

        .progress-track::before {
            content: "";
            position: absolute;
            top: 16px;
            left: 8%;
            right: 8%;
            height: 4px;
            background: #e2e8f0;
            z-index: 0;
        }

        .progress-step {
            position: relative;
            z-index: 1;
            text-align: center;
            width: 25%;
        }

        .progress-circle {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            background: #e2e8f0;
            color: #64748b;
            display: flex;
            justify-content: center;
            align-items: center;
            margin: 0 auto 10px;
            font-weight: 700;
            border: 3px solid white;
        }

        .progress-step.completed .progress-circle,
        .progress-step.current .progress-circle {
            background: #2563eb;
            color: white;
        }

        .progress-step p {
            color: #64748b;
            font-size: 12px;
            font-weight: 650;
            margin: 0;
        }

        .progress-step.completed p,
        .progress-step.current p {
            color: #172554;
        }

        .resolution-box {
            padding: 20px;
            border-radius: 12px;
            line-height: 1.7;
        }

        .resolution-success {
            background: #ecfdf5;
            border: 1px solid #bbf7d0;
            color: #166534;
        }

        .resolution-rejected {
            background: #fef2f2;
            border: 1px solid #fecaca;
            color: #991b1b;
        }

        .resolution-pending {
            background: #eff6ff;
            border: 1px solid #bfdbfe;
            color: #1e40af;
        }

        @media (max-width: 576px) {
            .details-header {
                padding: 23px 18px;
            }

            .details-card-body {
                padding: 18px;
            }

            .progress-track {
                margin-left: 0;
                margin-right: 0;
            }

            .progress-step p {
                font-size: 10px;
            }

            .progress-circle {
                width: 32px;
                height: 32px;
                font-size: 12px;
            }
        }
    </style>

</head>

<body>

    <%- include("../includes/navbar.ejs") %>

    <div class="container py-4 py-md-5">


        <!-- ================= PAGE HEADER ================= -->

        <div class="details-header">

            <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">

                <div>
                    <p class="small fw-semibold mb-2">
                        HOSTELCARE / COMPLAINT TRACKING
                    </p>

                    <h2 class="mb-2">
                        Complaint Details
                    </h2>

                    <p class="mb-0">
                        Track your maintenance request and its resolution.
                    </p>
                </div>

                <a href="/student/dashboard" class="btn btn-light fw-semibold">
                    ← Dashboard
                </a>

            </div>

        </div>


        <!-- ================= COMPLAINT SUMMARY ================= -->

        <div class="details-card">

            <div class="details-card-body">

                <div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-4">

                    <div>
                        <p class="detail-label">
                            Complaint Title
                        </p>

                        <h4 class="fw-bold mb-0" style="color: #172554;">
                            <%= complaint.title %>
                        </h4>
                    </div>


                    <span class="badge status-badge
                        <%= complaint.status === "Resolved" ? "bg-success" :
                            complaint.status === "Rejected" ? "bg-danger" :
                            complaint.status === "In Progress" ? "bg-info text-dark" :
                            complaint.status === "Assigned" ? "bg-primary" :
                            "bg-warning text-dark" %>">

                        <%= complaint.status %>

                    </span>

                </div>


                <div class="row g-3">

                    <div class="col-md-6">

                        <div class="detail-item">

                            <p class="detail-label">
                                Category
                            </p>

                            <p class="detail-value">
                                <%= complaint.category %>
                            </p>

                        </div>

                    </div>


                    <div class="col-md-6">

                        <div class="detail-item">

                            <p class="detail-label">
                                Room
                            </p>

                            <p class="detail-value">

                                <% if (complaint.room) { %>

                                    <%= complaint.room.roomNumber %>,
                                    Block <%= complaint.room.block %>

                                <% } else { %>

                                    Not available

                                <% } %>

                            </p>

                        </div>

                    </div>


                    <div class="col-md-6">

                        <div class="detail-item">

                            <p class="detail-label">
                                Submitted On
                            </p>

                            <p class="detail-value">
                                <%= complaint.createdAt.toLocaleDateString("en-IN") %>
                            </p>

                        </div>

                    </div>


                    <div class="col-md-6">

                        <div class="detail-item">

                            <p class="detail-label">
                                Assigned Staff
                            </p>

                            <p class="detail-value">

                                <% if (complaint.assignedTo) { %>

                                    <%= complaint.assignedTo.name %>

                                <% } else { %>

                                    <span class="text-muted">
                                        Not assigned yet
                                    </span>

                                <% } %>

                            </p>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- ================= PROGRESS TRACKER ================= -->

        <div class="details-card">

            <div class="details-card-header">

                <h5>
                    Complaint Progress
                </h5>

            </div>

            <div class="details-card-body">

                <% if (complaint.status === "Rejected") { %>

                    <div class="resolution-box resolution-rejected">
                        <strong>Complaint Rejected</strong>
                        <p class="mb-0 mt-1">
                            Your complaint has been rejected by the administration.
                        </p>
                    </div>

                <% } else { %>

                    <% let progress = 0 %>

                    <% if (complaint.status === "Assigned") { progress = 1 } %>
                    <% if (complaint.status === "In Progress") { progress = 2 } %>
                    <% if (complaint.status === "Resolved") { progress = 3 } %>

                    <div class="progress-track">

                        <div class="progress-step completed">

                            <div class="progress-circle">
                                ✓
                            </div>

                            <p>Submitted</p>

                        </div>


                        <div class="progress-step <%= progress >= 1 ? 'completed' : '' %>">

                            <div class="progress-circle">
                                <%= progress >= 1 ? "✓" : "2" %>
                            </div>

                            <p>Assigned</p>

                        </div>


                        <div class="progress-step <%= progress >= 2 ? 'completed' : '' %>">

                            <div class="progress-circle">
                                <%= progress >= 2 ? "✓" : "3" %>
                            </div>

                            <p>In Progress</p>

                        </div>


                        <div class="progress-step <%= progress >= 3 ? 'completed' : '' %>">

                            <div class="progress-circle">
                                <%= progress >= 3 ? "✓" : "4" %>
                            </div>

                            <p>Resolved</p>

                        </div>

                    </div>

                    <p class="text-muted small text-center mt-4 mb-0">

                        <% if (complaint.status === "Pending") { %>

                            Your complaint has been submitted and is waiting for admin assignment.

                        <% } else if (complaint.status === "Assigned") { %>

                            Your complaint has been assigned to a maintenance staff member.

                        <% } else if (complaint.status === "In Progress") { %>

                            The maintenance team is currently working on your complaint.

                        <% } else { %>

                            Your complaint has been successfully resolved.

                        <% } %>

                    </p>

                <% } %>

            </div>

        </div>


        <!-- ================= DESCRIPTION ================= -->

        <div class="details-card">

            <div class="details-card-header">

                <h5>
                    Problem Description
                </h5>

            </div>

            <div class="details-card-body">

                <div class="complaint-description">
                    <%= complaint.description %>
                </div>

            </div>

        </div>


        <!-- ================= RESOLUTION DETAILS ================= -->

        <div class="details-card">

            <div class="details-card-header">

                <h5>
                    Resolution Details
                </h5>

            </div>

            <div class="details-card-body">

                <% if (complaint.status === "Resolved") { %>

                    <div class="resolution-box resolution-success">

                        <h6 class="fw-bold">
                            ✓ Complaint Resolved
                        </h6>

                        <p class="mb-3">
                            Your complaint has been marked as resolved by the maintenance team.
                        </p>

                        <hr>

                        <strong>
                            Staff Resolution Note
                        </strong>

                        <% if (complaint.resolutionNote) { %>

                            <p class="mb-0 mt-2">
                                <%= complaint.resolutionNote %>
                            </p>

                        <% } else { %>

                            <p class="mb-0 mt-2">
                                No resolution note was added.
                            </p>

                        <% } %>

                    </div>

                <% } else if (complaint.status === "Rejected") { %>

                    <div class="resolution-box resolution-rejected">

                        <h6 class="fw-bold">
                            Complaint Rejected
                        </h6>

                        <p class="mb-0">
                            This complaint has been rejected. Please contact the hostel administrator if you need further clarification.
                        </p>

                    </div>

                <% } else { %>

                    <div class="resolution-box resolution-pending">

                        <h6 class="fw-bold">
                            Resolution Pending
                        </h6>

                        <p class="mb-0">
                            Your complaint is being processed. Resolution details will appear here once the complaint is resolved.
                        </p>

                    </div>

                <% } %>

            </div>

        </div>


        <!-- ================= FOOTER BUTTON ================= -->

        <div class="text-center mt-4">

            <a href="/student/dashboard" class="btn btn-primary px-4 py-2">
                ← Return to Dashboard
            </a>

        </div>

    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>
