
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Student Dashboard | HostelCare</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">

    <style>
        /* Student dashboard specific styling */

        .student-welcome {
            background: linear-gradient(120deg, #172554, #2563eb);
            color: white;
            padding: 35px;
            border-radius: 18px;
            margin-bottom: 28px;
            box-shadow: 0 10px 25px rgba(23, 37, 84, 0.15);
        }

        .student-welcome h2 {
            color: white;
            font-weight: 750;
        }

        .student-welcome p {
            color: #dbeafe;
        }

        .welcome-icon {
            font-size: 48px;
            background: rgba(255,255,255,0.15);
            width: 75px;
            height: 75px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 18px;
        }

        .room-card {
            background: white;
            border: 1px solid #e2e8f0;
            border-radius: 16px;
            padding: 23px;
            height: 100%;
            box-shadow: 0 5px 18px rgba(15, 23, 42, 0.04);
        }

        .room-icon {
            width: 45px;
            height: 45px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 12px;
            background: #eff6ff;
            font-size: 23px;
            margin-bottom: 15px;
        }

        .room-card h5 {
            color: #172554;
            font-weight: 700;
        }

        .room-value {
            color: #2563eb;
            font-size: 19px;
            font-weight: 700;
        }

        .dashboard-stat-card {
            height: 100%;
            border: 1px solid #e2e8f0;
            border-radius: 16px;
            background: white;
        }

        .stat-icon {
            width: 45px;
            height: 45px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 12px;
            font-size: 22px;
        }

        .stat-total {
            background: #eff6ff;
        }

        .stat-pending {
            background: #fef3c7;
        }

        .stat-resolved {
            background: #dcfce7;
        }

        .stat-number {
            font-size: 34px;
            font-weight: 750;
            color: #172554;
            margin-top: 12px;
            margin-bottom: 0;
        }

        .stat-label {
            color: #64748b;
            font-size: 14px;
            font-weight: 600;
        }

        .complaints-card {
            border: 1px solid #e2e8f0;
            border-radius: 16px;
            overflow: hidden;
            background: white;
        }

        .complaints-header {
            padding: 23px;
            border-bottom: 1px solid #e2e8f0;
        }

        .complaints-header h5 {
            color: #172554;
            font-weight: 750;
        }

        .empty-state {
            padding: 55px 20px;
        }

        .empty-icon {
            font-size: 48px;
            margin-bottom: 12px;
        }

        .dashboard-section-title {
            color: #172554;
            font-weight: 750;
            margin-bottom: 18px;
        }

        @media (max-width: 576px) {
            .student-welcome {
                padding: 25px 20px;
            }

            .welcome-icon {
                width: 58px;
                height: 58px;
                font-size: 32px;
            }

            .stat-number {
                font-size: 28px;
            }
        }
    </style>

</head>

<body>

    <%- include("../includes/navbar.ejs") %>

    <div class="container py-4 py-md-5">

        <!-- ================= WELCOME SECTION ================= -->

        <div class="student-welcome">

            <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">

                <div>
                    <p class="mb-2">STUDENT PORTAL</p>

                    <h2 class="mb-2">
                        Welcome, <%= user.name %>!
                    </h2>

                    <p class="mb-0">
                        Manage your hostel maintenance complaints from one place.
                    </p>
                </div>

                <div class="d-flex align-items-center gap-3">

                    <div class="welcome-icon">
                        👋
                    </div>

                    <form action="/logout" method="POST">
                        <button class="btn btn-light fw-semibold" type="submit">
                            Logout
                        </button>
                    </form>

                </div>

            </div>

        </div>


        <!-- ================= SUCCESS MESSAGE ================= -->

        <% if (success) { %>

            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <strong>Success!</strong> Your complaint has been submitted successfully.

                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>

        <% } %>


        <!-- ================= ROOM DETAILS ================= -->

        <h5 class="dashboard-section-title">
            My Accommodation
        </h5>

        <div class="row g-3 mb-4">

            <div class="col-md-6">

                <div class="room-card">

                    <div class="room-icon">
                        🏠
                    </div>

                    <h5>Room Details</h5>

                    <% if (user.room) { %>

                        <div class="d-flex justify-content-between align-items-center mt-3">

                            <div>
                                <p class="text-muted mb-1">Room Number</p>
                                <div class="room-value">
                                    <%= user.room.roomNumber %>
                                </div>
                            </div>

                            <div>
                                <p class="text-muted mb-1">Block</p>
                                <div class="room-value">
                                    <%= user.room.block %>
                                </div>
                            </div>

                        </div>

                    <% } else { %>

                        <p class="text-muted mb-0 mt-3">
                            No room has been assigned yet. Please contact the hostel administrator.
                        </p>

                    <% } %>

                </div>

            </div>

            <div class="col-md-6">

                <div class="room-card">

                    <div class="room-icon">
                        🛠️
                    </div>

                    <h5>Maintenance Support</h5>

                    <p class="text-muted mt-3 mb-3">
                        Facing any electrical, plumbing, cleaning or furniture issue?
                        Submit a complaint and track its progress.
                    </p>

                    <a href="/complaints/new" class="btn btn-primary">
                        + Report an Issue
                    </a>

                </div>

            </div>

        </div>


        <!-- ================= COMPLAINT STATISTICS ================= -->

        <h5 class="dashboard-section-title">
            Complaint Overview
        </h5>

        <div class="row g-3 mb-4">

            <!-- Total complaints -->

            <div class="col-md-4 col-sm-6">

                <div class="card dashboard-stat-card">

                    <div class="card-body">

                        <div class="stat-icon stat-total">
                            📋
                        </div>

                        <p class="stat-label mt-3 mb-0">
                            Total Complaints
                        </p>

                        <h2 class="stat-number">
                            <%= totalComplaints %>
                        </h2>

                    </div>

                </div>

            </div>


            <!-- Pending complaints -->

            <div class="col-md-4 col-sm-6">

                <div class="card dashboard-stat-card">

                    <div class="card-body">

                        <div class="stat-icon stat-pending">
                            ⏳
                        </div>

                        <p class="stat-label mt-3 mb-0">
                            Pending Complaints
                        </p>

                        <h2 class="stat-number">
                            <%= pendingComplaints %>
                        </h2>

                    </div>

                </div>

            </div>


            <!-- Resolved complaints -->

            <div class="col-md-4 col-sm-6">

                <div class="card dashboard-stat-card">

                    <div class="card-body">

                        <div class="stat-icon stat-resolved">
                            ✅
                        </div>

                        <p class="stat-label mt-3 mb-0">
                            Resolved Complaints
                        </p>

                        <h2 class="stat-number">
                            <%= resolvedComplaints %>
                        </h2>

                    </div>

                </div>

            </div>

        </div>


        <!-- ================= RECENT COMPLAINTS ================= -->

        <div class="complaints-card">

            <div class="complaints-header">

                <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">

                    <div>
                        <h5 class="mb-1">
                            My Recent Complaints
                        </h5>

                        <p class="text-muted small mb-0">
                            Track the latest updates on your maintenance requests.
                        </p>
                    </div>

                    <a href="/complaints/new" class="btn btn-primary">
                        + New Complaint
                    </a>

                </div>

            </div>


            <% if (complaints.length === 0) { %>

                <div class="text-center empty-state">

                    <div class="empty-icon">
                        📭
                    </div>

                    <h5 class="fw-bold">
                        No complaints yet!
                    </h5>

                    <p class="text-muted">
                        Your submitted complaints will appear here.
                    </p>

                    <a href="/complaints/new" class="btn btn-primary mt-2">
                        Submit Your First Complaint
                    </a>

                </div>

            <% } else { %>

                <div class="table-responsive">

                    <table class="table align-middle">

                        <thead>
                            <tr>
                                <th>Complaint</th>
                                <th>Category</th>
                                <th>Status</th>
                                <th>Date</th>
                                <th>Action</th>
                            </tr>
                        </thead>

                        <tbody>

                            <% complaints.slice(0, 5).forEach(complaint => { %>

                                <tr>

                                    <td>
                                        <strong>
                                            <%= complaint.title %>
                                        </strong>
                                    </td>

                                    <td>
                                        <%= complaint.category %>
                                    </td>

                                    <td>

                                        <% let statusColor = "secondary" %>

                                        <% if (complaint.status === "Pending") { %>
                                            <% statusColor = "warning" %>
                                        <% } else if (complaint.status === "Assigned") { %>
                                            <% statusColor = "info" %>
                                        <% } else if (complaint.status === "In Progress") { %>
                                            <% statusColor = "primary" %>
                                        <% } else if (complaint.status === "Resolved") { %>
                                            <% statusColor = "success" %>
                                        <% } else if (complaint.status === "Rejected") { %>
                                            <% statusColor = "danger" %>
                                        <% } %>

                                        <span class="badge text-bg-<%= statusColor %>">
                                            <%= complaint.status %>
                                        </span>

                                    </td>

                                    <td>
                                        <%= complaint.createdAt.toLocaleDateString("en-IN") %>
                                    </td>

                                    <td>
                                        <a
                                            href="/complaints/<%= complaint._id %>"
                                            class="btn btn-sm btn-outline-primary">
                                            View Details
                                        </a>
                                    </td>

                                </tr>

                            <% }) %>

                        </tbody>

                    </table>

                </div>

            <% } %>

        </div>

    </div>


    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>
