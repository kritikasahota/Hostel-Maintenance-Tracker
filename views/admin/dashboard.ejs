
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Admin Dashboard | HostelCare</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">

    <style>
        /* ADMIN DASHBOARD */

        .admin-welcome {
            background: linear-gradient(120deg, #172554, #2563eb);
            color: white;
            padding: 35px;
            border-radius: 18px;
            margin-bottom: 30px;
            box-shadow: 0 10px 25px rgba(23, 37, 84, 0.15);
        }

        .admin-welcome h2 {
            color: white;
            font-weight: 750;
        }

        .admin-welcome p {
            color: #dbeafe;
        }

        .admin-icon {
            width: 70px;
            height: 70px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 38px;
            border-radius: 18px;
            background: rgba(255,255,255,0.15);
        }

        .admin-stat-card {
            border: 1px solid #e2e8f0;
            border-radius: 16px;
            background: white;
            height: 100%;
            transition: 0.25s;
        }

        .admin-stat-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 12px 28px rgba(15, 23, 42, 0.1);
        }

        .admin-stat-card .card-body {
            padding: 23px;
        }

        .admin-stat-icon {
            font-size: 25px;
            width: 48px;
            height: 48px;
            display: flex;
            justify-content: center;
            align-items: center;
            background: #eff6ff;
            border-radius: 12px;
        }

        .admin-stat-card h3 {
            color: #172554;
            font-weight: 750;
            font-size: 30px;
            margin-top: 12px;
        }

        .admin-stat-card p {
            color: #64748b;
            margin-bottom: 0;
            font-size: 14px;
            font-weight: 600;
        }

        .admin-section-card {
            background: white;
            border: 1px solid #e2e8f0;
            border-radius: 16px;
            box-shadow: 0 5px 18px rgba(15, 23, 42, 0.04);
            overflow: hidden;
            margin-bottom: 25px;
        }

        .admin-section-header {
            padding: 22px 25px;
            border-bottom: 1px solid #e2e8f0;
        }

        .admin-section-header h5 {
            color: #172554;
            font-weight: 750;
            margin-bottom: 5px;
        }

        .admin-section-body {
            padding: 25px;
        }

        .admin-section-icon {
            width: 43px;
            height: 43px;
            background: #eff6ff;
            display: flex;
            justify-content: center;
            align-items: center;
            border-radius: 11px;
            font-size: 22px;
        }

        .room-count-badge {
            background: #eff6ff;
            color: #1d4ed8;
            padding: 7px 12px;
            border-radius: 8px;
            font-size: 13px;
            font-weight: 700;
        }

        .room-available {
            color: #15803d;
            font-weight: 700;
        }

        .room-full {
            color: #dc2626;
            font-weight: 700;
        }

        .admin-empty-state {
            text-align: center;
            padding: 35px 15px;
            color: #64748b;
        }

        .admin-empty-state div {
            font-size: 38px;
            margin-bottom: 10px;
        }

        .admin-section-body .form-control,
        .admin-section-body .form-select {
            padding: 12px;
        }

        @media (max-width: 576px) {
            .admin-welcome {
                padding: 25px 20px;
            }

            .admin-section-body {
                padding: 20px;
            }

            .admin-section-header {
                padding: 18px;
            }
        }
    </style>

</head>

<body>

    <%- include("../includes/navbar.ejs") %>

    <div class="container py-4 py-md-5">

        <!-- ================= WELCOME SECTION ================= -->

        <div class="admin-welcome">

            <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">

                <div>
                    <p class="mb-2">HOSTELCARE ADMIN PORTAL</p>

                    <h2 class="mb-2">
                        Admin Dashboard
                    </h2>

                    <p class="mb-0">
                        Manage hostel rooms, student allocation and accommodation records.
                    </p>
                </div>

                <div class="admin-icon">
                    🏢
                </div>

            </div>

        </div>


        <!-- ================= STATISTICS ================= -->

        <div class="row g-3 mb-4">

            <div class="col-md-4 col-sm-6">

                <div class="card admin-stat-card">

                    <div class="card-body">

                        <div class="admin-stat-icon">
                            🏠
                        </div>

                        <p class="mt-3">
                            Total Rooms
                        </p>

                        <h3>
                            <%= rooms.length %>
                        </h3>

                    </div>

                </div>

            </div>


            <div class="col-md-4 col-sm-6">

                <div class="card admin-stat-card">

                    <div class="card-body">

                        <div class="admin-stat-icon">
                            👨‍🎓
                        </div>

                        <p class="mt-3">
                            Total Students
                        </p>

                        <h3>
                            <%= students.length %>
                        </h3>

                    </div>

                </div>

            </div>


            <div class="col-md-4 col-sm-6">

                <div class="card admin-stat-card">

                    <div class="card-body">

                        <div class="admin-stat-icon">
                            🛏️
                        </div>

                        <p class="mt-3">
                            Students Without Room
                        </p>

                        <h3>
                            <%= students.filter(student => !student.room).length %>
                        </h3>

                    </div>

                </div>

            </div>

        </div>


        <!-- ================= ADD NEW ROOM ================= -->

        <div class="admin-section-card">

            <div class="admin-section-header">

                <div class="d-flex align-items-center gap-3">

                    <div class="admin-section-icon">
                        ➕
                    </div>

                    <div>
                        <h5>Add New Room</h5>
                        <p class="text-muted small mb-0">
                            Add a room to your hostel inventory.
                        </p>
                    </div>

                </div>

            </div>


            <div class="admin-section-body">

                <form action="/admin/rooms" method="POST">

                    <div class="row g-3">

                        <div class="col-md-3">

                            <label class="form-label">
                                Room Number
                            </label>

                            <input
                                type="text"
                                name="roomNumber"
                                class="form-control"
                                placeholder="e.g. 101"
                                required>

                        </div>


                        <div class="col-md-3">

                            <label class="form-label">
                                Block
                            </label>

                            <input
                                type="text"
                                name="block"
                                class="form-control"
                                placeholder="e.g. A"
                                required>

                        </div>


                        <div class="col-md-3">

                            <label class="form-label">
                                Floor
                            </label>

                            <input
                                type="number"
                                name="floor"
                                class="form-control"
                                placeholder="e.g. 1"
                                min="0"
                                required>

                        </div>


                        <div class="col-md-3">

                            <label class="form-label">
                                Room Capacity
                            </label>

                            <input
                                type="number"
                                name="capacity"
                                class="form-control"
                                placeholder="e.g. 2"
                                min="1"
                                required>

                        </div>

                    </div>


                    <button class="btn btn-primary mt-4" type="submit">
                        + Add Room
                    </button>

                </form>

            </div>

        </div>


        <!-- ================= ROOM LIST ================= -->

        <div class="admin-section-card">

            <div class="admin-section-header">

                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">

                    <div class="d-flex align-items-center gap-3">

                        <div class="admin-section-icon">
                            🏠
                        </div>

                        <div>
                            <h5>Hostel Room Management</h5>
                            <p class="text-muted small mb-0">
                                View room capacity and occupancy.
                            </p>
                        </div>

                    </div>

                    <span class="room-count-badge">
                        <%= rooms.length %> Rooms
                    </span>

                </div>

            </div>


            <div class="admin-section-body">

                <% if (rooms.length === 0) { %>

                    <div class="admin-empty-state">

                        <div>🏠</div>

                        <h6 class="fw-bold">
                            No Rooms Available
                        </h6>

                        <p class="mb-0">
                            Add your first hostel room using the form above.
                        </p>

                    </div>

                <% } else { %>

                    <div class="table-responsive">

                        <table class="table align-middle">

                            <thead>
                                <tr>
                                    <th>Room</th>
                                    <th>Block</th>
                                    <th>Floor</th>
                                    <th>Capacity</th>
                                    <th>Occupied</th>
                                    <th>Available</th>
                                </tr>
                            </thead>

                            <tbody>

                                <% rooms.forEach(room => { %>

                                    <% const occupied = students.filter(student =>
                                        student.room &&
                                        student.room._id.toString() === room._id.toString()
                                    ).length %>

                                    <% const available = room.capacity - occupied %>

                                    <tr>

                                        <td>
                                            <strong>
                                                <%= room.roomNumber %>
                                            </strong>
                                        </td>

                                        <td>
                                            Block <%= room.block %>
                                        </td>

                                        <td>
                                            <%= room.floor %>
                                        </td>

                                        <td>
                                            <%= room.capacity %>
                                        </td>

                                        <td>
                                            <%= occupied %>
                                        </td>

                                        <td>

                                            <% if (available > 0) { %>

                                                <span class="room-available">
                                                    <%= available %> Available
                                                </span>

                                            <% } else { %>

                                                <span class="room-full">
                                                    Full
                                                </span>

                                            <% } %>

                                        </td>

                                    </tr>

                                <% }) %>

                            </tbody>

                        </table>

                    </div>

                <% } %>

            </div>

        </div>


        <!-- ================= ASSIGN ROOM ================= -->

        <div class="admin-section-card">

            <div class="admin-section-header">

                <div class="d-flex align-items-center gap-3">

                    <div class="admin-section-icon">
                        🛏️
                    </div>

                    <div>
                        <h5>Assign Room to Student</h5>
                        <p class="text-muted small mb-0">
                            Allocate an available room to a registered student.
                        </p>
                    </div>

                </div>

            </div>


            <div class="admin-section-body">

                <% if (students.filter(student => !student.room).length === 0) { %>

                    <div class="alert alert-info mb-0">
                        All registered students have already been assigned a room.
                    </div>

                <% } else { %>

                    <form action="/admin/assign-room" method="POST">

                        <div class="row g-3">

                            <div class="col-md-6">

                                <label class="form-label">
                                    Select Student
                                </label>

                                <select
                                    name="studentId"
                                    class="form-select"
                                    required>

                                    <option value="">
                                        Choose a Student
                                    </option>

                                    <% students.filter(student => !student.room).forEach(student => { %>

                                        <option value="<%= student._id %>">
                                            <%= student.name %> - <%= student.email %>
                                        </option>

                                    <% }) %>

                                </select>

                            </div>


                            <div class="col-md-6">

                                <label class="form-label">
                                    Select Available Room
                                </label>

                                <select
                                    name="roomId"
                                    class="form-select"
                                    required>

                                    <option value="">
                                        Choose a Room
                                    </option>

                                    <% rooms.forEach(room => { %>

                                        <% const occupied = students.filter(student =>
                                            student.room &&
                                            student.room._id.toString() === room._id.toString()
                                        ).length %>

                                        <% if (occupied < room.capacity) { %>

                                            <option value="<%= room._id %>">

                                                Room <%= room.roomNumber %> -
                                                Block <%= room.block %>

                                                (Available: <%= room.capacity - occupied %>)

                                            </option>

                                        <% } %>

                                    <% }) %>

                                </select>

                            </div>

                        </div>


                        <button class="btn btn-success mt-4" type="submit">
                            Assign Room
                        </button>

                    </form>

                <% } %>

            </div>

        </div>

    </div>


    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>
