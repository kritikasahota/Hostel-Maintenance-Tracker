
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Staff Dashboard | HostelCare</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">

    <style>
        /* STAFF DASHBOARD */

        .staff-welcome {
            background: linear-gradient(120deg, #172554, #2563eb);
            color: white;
            padding: 35px;
            border-radius: 18px;
            margin-bottom: 28px;
            box-shadow: 0 10px 25px rgba(23, 37, 84, 0.15);
        }

        .staff-welcome h2 {
            color: white;
            font-weight: 750;
        }

        .staff-welcome p {
            color: #dbeafe;
        }

        .staff-welcome-icon {
            width: 70px;
            height: 70px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 38px;
            background: rgba(255,255,255,0.15);
            border-radius: 18px;
        }

        .staff-stat-card {
            border: 1px solid #e2e8f0;
            border-radius: 16px;
            background: white;
            height: 100%;
            transition: 0.25s;
        }

        .staff-stat-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 12px 28px rgba(15, 23, 42, 0.1);
        }

        .staff-stat-icon {
            width: 46px;
            height: 46px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 24px;
            background: #eff6ff;
            border-radius: 12px;
        }

        .staff-stat-card h2 {
            color: #172554;
            font-size: 32px;
            font-weight: 750;
            margin-top: 12px;
        }

        .staff-stat-card p {
            color: #64748b;
            font-weight: 600;
            margin-bottom: 0;
        }

        .staff-task-card {
            background: white;
            border: 1px solid #e2e8f0;
            border-radius: 16px;
            overflow: hidden;
            box-shadow: 0 5px 18px rgba(15, 23, 42, 0.04);
        }

        .staff-task-header {
            padding: 23px 25px;
            border-bottom: 1px solid #e2e8f0;
        }

        .staff-task-header h5 {
            color: #172554;
            font-weight: 750;
        }

        .staff-task-table {
            min-width: 1050px;
        }

        .staff-task-table thead th {
            background: #eff6ff;
            color: #172554;
            font-size: 12px;
            font-weight: 700;
            text-transform: uppercase;
            white-space: nowrap;
        }

        .staff-task-table tbody td {
            padding: 17px 12px;
            font-size: 14px;
        }

        .staff-description {
            min-width: 180px;
            max-width: 240px;
            white-space: normal;
            color: #64748b;
            line-height: 1.6;
        }

        .staff-update-form {
            min-width: 190px;
        }

        .staff-update-form .form-control,
        .staff-update-form .form-select {
            font-size: 13px;
        }

        .staff-empty-state {
            padding: 65px 20px;
            text-align: center;
        }

        .staff-empty-icon {
            font-size: 50px;
            margin-bottom: 15px;
        }

        .staff-empty-state h5 {
            color: #172554;
            font-weight: 700;
        }

        .staff-section-title {
            color: #172554;
            font-weight: 750;
        }

        @media (max-width: 576px) {
            .staff-welcome {
                padding: 25px 20px;
            }

            .staff-task-header {
                padding: 18px;
            }

            .staff-welcome-icon {
                width: 58px;
                height: 58px;
                font-size: 30px;
            }
        }
    </style>

</head>

<body>

    <%- include("../includes/navbar.ejs") %>

    <div class="container py-4 py-md-5">


        <!-- ================= WELCOME SECTION ================= -->

        <div class="staff-welcome">

            <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">

                <div>

                    <p class="mb-2">
                        HOSTELCARE STAFF PORTAL
                    </p>

                    <h2 class="mb-2">
                        Staff Dashboard
                    </h2>

                    <p class="mb-0">
                        Manage your assigned maintenance tasks and update their progress.
                    </p>

                </div>

                <div class="d-flex align-items-center gap-3">

                    <div class="staff-welcome-icon">
                        🛠️
                    </div>

                    <form action="/logout" method="POST">

                        <button type="submit" class="btn btn-light fw-semibold">
                            Logout
                        </button>

                    </form>

                </div>

            </div>

        </div>


        <!-- ================= STATISTICS ================= -->

        <h5 class="staff-section-title mb-3">
            My Work Overview
        </h5>

        <div class="row g-3 mb-4">

            <div class="col-md-4 col-sm-6">

                <div class="card staff-stat-card">

                    <div class="card-body p-4">

                        <div class="staff-stat-icon">
                            📋
                        </div>

                        <p class="mt-3">
                            Assigned Complaints
                        </p>

                        <h2>
                            <%= complaints.length %>
                        </h2>

                    </div>

                </div>

            </div>


            <div class="col-md-4 col-sm-6">

                <div class="card staff-stat-card">

                    <div class="card-body p-4">

                        <div class="staff-stat-icon">
                            🔧
                        </div>

                        <p class="mt-3">
                            In Progress
                        </p>

                        <h2>
                            <%= complaints.filter(c => c.status === "In Progress").length %>
                        </h2>

                    </div>

                </div>

            </div>


            <div class="col-md-4 col-sm-6">

                <div class="card staff-stat-card">

                    <div class="card-body p-4">

                        <div class="staff-stat-icon">
                            ✅
                        </div>

                        <p class="mt-3">
                            Resolved
                        </p>

                        <h2>
                            <%= complaints.filter(c => c.status === "Resolved").length %>
                        </h2>

                    </div>

                </div>

            </div>

        </div>


        <!-- ================= ASSIGNED TASKS ================= -->

        <div class="staff-task-card">

            <div class="staff-task-header">

                <div>
                    <h5 class="mb-1">
                        My Assigned Complaints
                    </h5>

                    <p class="text-muted small mb-0">
                        View complaint details and update maintenance progress.
                    </p>
                </div>

            </div>


            <% if (complaints.length === 0) { %>

                <div class="staff-empty-state">

                    <div class="staff-empty-icon">
                        📭
                    </div>

                    <h5>
                        No Tasks Assigned Yet
                    </h5>

                    <p class="text-muted mb-0">
                        New complaints assigned by the admin will appear here.
                    </p>

                </div>

            <% } else { %>

                <div class="table-responsive">

                    <table class="table align-middle staff-task-table">

                        <thead>

                            <tr>
                                <th>Student</th>
                                <th>Room</th>
                                <th>Complaint</th>
                                <th>Category</th>
                                <th>Description</th>
                                <th>Status</th>
                                <th>Update Task</th>
                            </tr>

                        </thead>


                        <tbody>

                            <% complaints.forEach(complaint => { %>

                                <tr>


                                    <!-- STUDENT -->

                                    <td>
                                        <strong>
                                            <%= complaint.student
                                                ? complaint.student.name
                                                : "Unknown Student" %>
                                        </strong>

                                        <div class="text-muted small">
                                            <%= complaint.student
                                                ? complaint.student.email
                                                : "" %>
                                        </div>
                                    </td>


                                    <!-- ROOM -->

                                    <td>

                                        <% if (complaint.room) { %>

                                            <strong>
                                                <%= complaint.room.roomNumber %>
                                            </strong>

                                            <div class="text-muted small">
                                                Block <%= complaint.room.block %>
                                            </div>

                                        <% } else { %>

                                            <span class="text-muted">
                                                Not available
                                            </span>

                                        <% } %>

                                    </td>


                                    <!-- COMPLAINT -->

                                    <td>
                                        <strong>
                                            <%= complaint.title %>
                                        </strong>
                                    </td>


                                    <!-- CATEGORY -->

                                    <td>
                                        <%= complaint.category %>
                                    </td>


                                    <!-- DESCRIPTION -->

                                    <td>
                                        <div class="staff-description">
                                            <%= complaint.description %>
                                        </div>
                                    </td>


                                    <!-- STATUS -->

                                    <td>

                                        <% let statusClass = "warning" %>

                                        <% if (complaint.status === "In Progress") { %>
                                            <% statusClass = "primary" %>
                                        <% } else if (complaint.status === "Resolved") { %>
                                            <% statusClass = "success" %>
                                        <% } %>

                                        <span class="badge text-bg-<%= statusClass %>">
                                            <%= complaint.status %>
                                        </span>

                                    </td>


                                    <!-- UPDATE FORM -->

                                    <td>

                                        <form
                                            action="/staff/complaints/<%= complaint._id %>/status"
                                            method="POST"
                                            class="staff-update-form">


                                            <label class="form-label">
                                                Update Status
                                            </label>

                                            <select
                                                name="status"
                                                class="form-select mb-2"
                                                required>

                                                <option
                                                    value="In Progress"
                                                    <%= complaint.status === "In Progress" ? "selected" : "" %>>

                                                    In Progress

                                                </option>

                                                <option
                                                    value="Resolved"
                                                    <%= complaint.status === "Resolved" ? "selected" : "" %>>

                                                    Resolved

                                                </option>

                                            </select>


                                            <label class="form-label">
                                                Resolution Note
                                            </label>

                                            <textarea
                                                name="resolutionNote"
                                                class="form-control mb-2"
                                                rows="3"
                                                placeholder="Describe the work completed..."><%= complaint.resolutionNote || "" %></textarea>


                                            <button
                                                type="submit"
                                                class="btn btn-primary btn-sm w-100">

                                                Update Task

                                            </button>

                                        </form>

                                    </td>

                                </tr>

                            <% }) %>

                        </tbody>

                    </table>

                </div>

            <% } %>

        </div>

    </div>


    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>
